<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.saga-it</groupId>
    <artifactId>mirthsync-plugin</artifactId>
    <version>0.0.3</version>
    <packaging>pom</packaging>

    <url>https://saga-it.com/products/mirthsync-plugin</url>
    <organization>
        <name>Saga IT, LLC</name>
        <url>https://saga-it.com</url>
    </organization>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>server</module>
        <module>shared</module>
        <module>client</module>
    </modules>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <mirth.version>4.5.2</mirth.version>

        <maven-processor-plugin.version>5.1</maven-processor-plugin.version>
        <maven-assembly-plugin.version>3.7.1</maven-assembly-plugin.version>
        <mirth-plugin-maven-plugin.version>3.0.0</mirth-plugin-maven-plugin.version>
        <miglayout.version>3.7.4</miglayout.version>
        <saga.runtime.artifacts>clj-http,clj-jgit,clj-tuple,environ,org.eclipse.jgit,org.eclipse.jgit.gpg.bc,org.eclipse.jgit.ssh.apache,potemkin,riddley,slingshot,JavaEWAH,eddsa,httpasyncclient,httpclient-cache,httpcore-nio,sshd-osgi,sshd-sftp,bcpg-jdk18on,clojure,core.specs.alpha,data.xml,data.zip,spec.alpha,tools.cli,tools.logging,incomplete,mirthsync</saga.runtime.artifacts>

        <!-- Plugin details -->
        <mirth.plugin.author>Saga IT, LLC</mirth.plugin.author>
        <mirth.plugin.compatible_versions>4.5.2</mirth.plugin.compatible_versions>
        <mirth.plugin.description>MirthSync Git integration plugin by Saga IT, LLC.</mirth.plugin.description>
        <mirth.plugin.name>MirthSync Plugin</mirth.plugin.name>
        <mirth.plugin.path>mirthsync-plugin</mirth.plugin.path>
        <mirth.plugin.url>https://www.saga-it.com</mirth.plugin.url>
        <mirth.plugin.version>${project.version}</mirth.plugin.version>
    </properties>

    <repositories>
        <repository>
            <id>repsy-default</id>
            <url>https://repo.repsy.io/mvn/kpalang/default</url>
        </repository>
        <repository>
            <id>repsy-mirthconnect</id>
            <url>https://repo.repsy.io/mvn/kpalang/mirthconnect</url>
        </repository>
        <repository>
            <id>clojars</id>
            <url>https://repo.clojars.org/</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>repsy-default</id>
            <url>https://repo.repsy.io/mvn/kpalang/default</url>
        </pluginRepository>
    </pluginRepositories>

    <dependencies>
        <!-- Helper plugin to handle Mirth plugin specific tasks. -->
        <dependency>
            <groupId>com.kaurpalang</groupId>
            <artifactId>mirth-plugin-maven-plugin</artifactId>
            <version>${mirth-plugin-maven-plugin.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.mirth.connect</groupId>
            <artifactId>mirth-server</artifactId>
            <version>${mirth.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Specify naming pattern for submodules. For example pluginname-client.jar -->
        <finalName>${project.parent.artifactId}-${project.artifactId}</finalName>

        <plugins>

            <plugin>
                <groupId>org.bsc.maven</groupId>
                <artifactId>maven-processor-plugin</artifactId>
                <version>${maven-processor-plugin.version}</version>
                <executions>
                    <execution>
                        <id>process</id>
                        <goals>
                            <goal>process</goal>
                        </goals>
                        <phase>process-sources</phase>

                        <configuration>
                            <processors>
                                <processor>com.kaurpalang.mirth.annotationsplugin.processor.MirthPluginProcessor</processor>
                            </processors>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
